---
import { getEntry } from "astro:content";
import Button from "../components/Button.astro";
import SiteLayout from "../components/SiteLayout.astro";
import { buildPageHeadMetadata } from "../lib/site";

const homeEntry = await getEntry("pages", "home");

if (!homeEntry) {
  throw new Error("Missing home page metadata entry.");
}

const pageHead = buildPageHeadMetadata(homeEntry.data);
const pillars = [
  {
    number: "01",
    title: "Own machine",
    body: "Each agent works on its own governed machine through the Glaux desktop app.",
    image: "/product/desktop-800.webp",
    alt: "The Glaux desktop app with a new session, artifacts, and automations.",
    width: 800,
    height: 500,
  },
  {
    number: "02",
    title: "Approved tools",
    body: "Your admin chooses which tools, including MCP tools, each person can use.",
    image: "/product/approved-tools-800.webp",
    alt: "Glaux admin console showing workspace permissions for MCP tools.",
    width: 800,
    height: 500,
  },
  {
    number: "03",
    title: "Approvals",
    body: "In the desktop app, a destructive command can wait for a person to run or reject it.",
    image: "/product/desktop-approval-750.webp",
    alt: "A real desktop approval card with the database command and Reject and Run controls.",
    width: 750,
    height: 230,
  },
  {
    number: "04",
    title: "Audit",
    body: "Review the desktop action and result. Use admin audit to review policy and access changes.",
    image: "/product/desktop-result-800.webp",
    alt: "Desktop action history showing a database command and its completed result in a disposable demo.",
    width: 800,
    height: 60,
  },
];
---

<SiteLayout
  title={pageHead.title}
  description={pageHead.description}
  canonicalUrl={pageHead.canonicalUrl}
  noindex
  og={pageHead.og}
>
  <div class="home-page home-refresh">
    <section class="home-hero" aria-labelledby="home-heading">
      <div class="home-hero__copy">
        <p class="plain-label">A governed AI coworker</p>
        <h1 id="home-heading" class="home-title">
          Your agent shouldn't reach production unless you say so.
        </h1>
        <p class="home-lede">
          Glaux is a governed AI coworker. Each agent runs in the Glaux desktop
          app, on its own machine, with only the tools your admin approved.
          Destructive actions are blocked or wait for a person. Then you can see
          exactly what happened.
        </p>
        <div class="home-actions" aria-label="Primary home actions">
          <Button href="https://www.glauxagent.com/contact/" variant="primary"
            >Book a demo</Button
          >
          <span class="walkthrough-placeholder">
            Watch the walkthrough <small
              >Coming soon · video not yet available</small
            >
          </span>
        </div>
      </div>
      <figure class="hero-capture">
        <div class="capture-label">
          <span>Glaux desktop app</span><span>Real product capture</span>
        </div>
        <img
          src="/product/desktop-1600.webp"
          srcset="/product/desktop-800.webp 800w, /product/desktop-1600.webp 1600w"
          sizes="(max-width: 60rem) calc(100vw - 2.5rem), 50vw"
          alt="The Glaux desktop app, ready for a new work session."
          width="1600"
          height="1000"
          fetchpriority="high"
          decoding="async"
        />
        <figcaption>
          Your coworker starts here. Its tools start with your rules.
        </figcaption>
      </figure>
    </section>

    <section class="incident-section" aria-labelledby="problem-heading">
      <div class="section-heading">
        <p class="plain-label">Based on public reports · 2025</p>
        <h2 id="problem-heading">
          A prompt is a request. It isn't a boundary.
        </h2>
        <p>
          When an agent can reach the wrong thing, a routine task can become a
          recovery job.
        </p>
      </div>
      <div class="incident-grid">
        <article>
          <p class="plain-label">A production database</p>
          <h3>Deleted during a code freeze.</h3>
          <p>
            Public reporting described a Replit agent deleting production data
            despite instructions to stop changes. Replit later confirmed the
            deletion and recovery.
          </p>
          <div class="source-links">
            <a
              href="https://www.theregister.com/2025/07/21/replit_saastr_vibe_coding_incident/"
              >Read the reporting ↗</a
            >
            <a
              href="https://replit.com/blog/doubling-down-on-our-commitment-to-secure-vibe-coding"
              >Replit's response ↗</a
            >
          </div>
        </article>
        <article>
          <p class="plain-label">A person's home folder</p>
          <h3>A cleanup command went too far.</h3>
          <p>
            A Claude Code user reported a recursive delete reaching their home
            directory. This is a public issue report, not an independently
            verified finding.
          </p>
          <div class="source-links">
            <a href="https://github.com/anthropics/claude-code/issues/12637"
              >Read the issue report ↗</a
            >
          </div>
        </article>
      </div>
    </section>

    <section class="runtime-section" aria-labelledby="runtime-heading">
      <div>
        <p class="plain-label">The difference is where work runs</p>
        <h2 id="runtime-heading">
          Give people an agent with the boundary built in.
        </h2>
      </div>
      <div class="runtime-contrast">
        <div>
          <h3>Discovery and posture tools</h3>
          <p>
            Help you find and watch agents already running across your company.
          </p>
        </div>
        <div>
          <h3>Glaux is the governed runtime</h3>
          <p>
            The coworker your team uses, inside its own machine, with the tools
            your admin approved. A complementary place to put useful work.
          </p>
        </div>
      </div>
    </section>

    <section class="pillars-section" aria-labelledby="pillars-heading">
      <div class="section-heading">
        <p class="plain-label">Useful work. Visible control.</p>
        <h2 id="pillars-heading">Four guardrails around the work.</h2>
      </div>
      <div class="pillars-grid">
        {
          pillars.map((pillar) => (
            <article>
              <div class="pillar-heading">
                <>
                  <span>{pillar.number}</span>
                  <h3>{pillar.title}</h3>
                </>
              </div>
              <p>{pillar.body}</p>
              <div class="pillar-capture">
                <img
                  src={pillar.image}
                  alt={pillar.alt}
                  width={pillar.width}
                  height={pillar.height}
                  loading="lazy"
                  decoding="async"
                />
              </div>
            </article>
          ))
        }
      </div>
      <p class="capture-note">
        Real product captures with synthetic demo data. The audit image shows
        desktop action history; it is not a joined admin audit record.
      </p>
    </section>

    <section
      class="scenario-section"
      id="cleanup"
      aria-labelledby="scenario-heading"
    >
      <div class="section-heading">
        <p class="plain-label">One cleanup. Two responsibilities.</p>
        <h2 id="scenario-heading">“Clean up this old database table.”</h2>
        <p>
          A small request with a destructive step. The desktop app shows the
          command. The admin console controls which database tools are
          available.
        </p>
      </div>
      <div class="scenario-grid">
        <figure>
          <figcaption>
            <span class="plain-label">Glaux desktop app</span><h3>
              A person gets the final say.
            </h3><p>
              The staged demo holds a table deletion at a native Run / Reject
              approval card.
            </p>
          </figcaption>
          <div class="scenario-capture scenario-capture--approval">
            <img
              src="/product/desktop-approval-750.webp"
              alt="The desktop app holding a table deletion for Run or Reject."
              width="750"
              height="230"
              loading="lazy"
              decoding="async"
            />
          </div>
        </figure>
        <figure>
          <figcaption>
            <span class="plain-label">Glaux admin console</span><h3>
              Tool access is an admin decision.
            </h3><p>
              Read-only MCP tools have explicit permissions for the person and
              workspace.
            </p>
          </figcaption>
          <div class="scenario-capture">
            <img
              src="/product/approved-tools-800.webp"
              srcset="/product/approved-tools-800.webp 800w, /product/approved-tools-1600.webp 1600w"
              sizes="(max-width: 48rem) calc(100vw - 2.5rem), 50vw"
              alt="Glaux admin console showing allowed read-only database tools for the synthetic Acme workspace."
              width="800"
              height="500"
              loading="lazy"
              decoding="async"
            />
          </div>
        </figure>
      </div>
      <p class="capture-note">
        Separate staged captures on disposable demo data. Desktop command
        approval and admin tool access are distinct controls; these images do
        not show an end-to-end production run.
      </p>
    </section>

    <section class="security-cta" aria-labelledby="security-heading">
      <div class="section-heading section-heading--compact">
        <p class="plain-label">Security, honestly</p>
        <h2 id="security-heading">Start with what it can reach.</h2>
        <p>
          Review tool permissions, the desktop approval boundary, and what gets
          recorded. Deployment and data-handling terms belong in your security
          review.
        </p>
      </div>
      <Button href="/security/" variant="ghost">Read security details</Button>
    </section>

    <aside class="stage-note" aria-label="Product stage">
      <span class="plain-label">Design-partner stage</span>
      <p>
        We're working with early teams. Glaux is not generally available or open
        for self-serve signup. <a href="/company/">Meet Glaux ↗</a>
      </p>
      <a href="/product/#what-comes-next">See what's in preview ↗</a>
    </aside>

    <section class="closing-cta" aria-labelledby="close-heading">
      <h2 id="close-heading">Real work. Your guardrails.</h2>
      <p>
        Walk through one workflow: the tool boundary, the desktop approval
        point, and the record you can review.
      </p>
      <Button href="https://www.glauxagent.com/contact/" variant="primary"
        >Book a demo</Button
      >
    </section>
  </div>
</SiteLayout>

<style>
  .home-refresh {
    padding-block-end: var(--space-8);
  }
  .home-refresh .home-hero {
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: center;
    justify-items: stretch;
    gap: var(--space-12);
    min-height: 45rem;
  }
  .home-refresh .home-hero__copy {
    justify-items: start;
    text-align: left;
  }
  .home-refresh .home-title {
    max-width: 15ch;
    font-size: clamp(2.8rem, 1.5rem + 3.5vw, 4.75rem);
  }
  .home-refresh .home-lede {
    font-size: clamp(1rem, 0.9rem + 0.25vw, 1.15rem);
  }
  .home-refresh .home-actions {
    align-items: center;
    gap: var(--space-6);
  }
  .walkthrough-placeholder {
    display: grid;
    gap: var(--space-1);
    font-size: 0.9rem;
    font-weight: 600;
  }
  .walkthrough-placeholder small {
    color: var(--color-body);
    font-size: 0.75rem;
    font-weight: 400;
  }
  figure {
    margin: 0;
  }
  .hero-capture {
    overflow: hidden;
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-md);
    background: var(--color-primary-wash);
    padding: var(--space-4);
  }
  .capture-label {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-2);
    padding-block-end: var(--space-4);
    color: var(--color-primary-ink);
    font-size: 0.75rem;
    font-weight: 600;
  }
  .hero-capture img {
    width: 100%;
    height: auto;
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-sm);
  }
  .hero-capture figcaption {
    padding-block-start: var(--space-4);
    color: var(--color-primary-ink);
    font-size: 0.85rem;
  }
  .incident-section,
  .pillars-section,
  .scenario-section {
    padding-block: var(--space-20);
    border-top: 1px solid var(--color-hairline);
  }
  .incident-grid,
  .pillars-grid,
  .scenario-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-8);
  }
  .incident-grid article {
    border-top: 2px solid var(--color-graphite);
    padding-block-start: var(--space-6);
    display: grid;
    gap: var(--space-4);
    align-content: start;
  }
  h3 {
    font-size: var(--text-h3);
  }
  .incident-grid article > p:not(.plain-label),
  .pillars-grid article > p,
  .scenario-grid figcaption > p,
  .runtime-contrast p {
    color: var(--color-body);
  }
  .source-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    font-size: 0.85rem;
  }
  .source-links a,
  .stage-note a {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .runtime-section {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-12);
    background: var(--color-carbon);
    color: var(--color-chalk);
    padding: var(--space-12);
    border-radius: var(--radius-md);
  }
  .runtime-section h2 {
    margin-block-start: var(--space-4);
    font-size: var(--text-h2);
  }
  .runtime-section .plain-label {
    color: var(--color-primary-line);
  }
  .runtime-contrast {
    display: grid;
    gap: var(--space-8);
  }
  .runtime-contrast h3 {
    margin-block-end: var(--space-3);
  }
  .runtime-contrast p {
    color: var(--color-hairline);
  }
  .pillars-section {
    margin-block-start: var(--space-20);
  }
  .pillars-grid {
    row-gap: var(--space-12);
  }
  .pillars-grid article {
    min-width: 0;
    display: grid;
    grid-template-rows: auto auto 1fr;
    gap: var(--space-4);
  }
  .pillar-heading {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }
  .pillar-heading > span {
    color: var(--color-primary);
    font-size: 0.85rem;
  }
  .pillar-capture,
  .scenario-capture {
    display: grid;
    align-items: center;
    overflow: hidden;
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-sm);
    background: var(--color-soft);
  }
  .pillar-capture {
    aspect-ratio: 8 / 5;
  }
  .pillar-capture img,
  .scenario-capture img {
    width: 100%;
    height: auto;
  }
  .capture-note {
    max-width: 65rem;
    margin-block-start: var(--space-6);
    color: var(--color-body);
    font-size: 0.8rem;
  }
  .scenario-grid figcaption {
    display: grid;
    gap: var(--space-3);
    margin-block-end: var(--space-6);
  }
  .scenario-capture {
    aspect-ratio: 8 / 5;
  }
  .scenario-capture--approval {
    padding: var(--space-4);
  }
  .stage-note {
    display: grid;
    gap: var(--space-3);
    padding-block: var(--space-12);
    font-size: 0.95rem;
  }
  .stage-note > p {
    max-width: 55rem;
    color: var(--color-body);
  }
  .home-refresh .closing-cta {
    margin-block: 0 var(--space-12);
  }
  .home-refresh .closing-cta h2 {
    max-width: 12ch;
    font-size: clamp(2.5rem, 2rem + 2vw, 4.5rem);
  }
  @media (max-width: 60rem) {
    .home-refresh .home-hero {
      grid-template-columns: 1fr;
      gap: var(--space-10);
      padding-block: var(--space-12);
    }
    .home-refresh .home-title {
      max-width: 19ch;
    }
    .home-hero__copy {
      max-width: 45rem;
    }
    .hero-capture {
      width: 100%;
    }
    .runtime-section {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
  }
  @media (max-width: 48rem) {
    .incident-grid,
    .pillars-grid,
    .scenario-grid {
      grid-template-columns: 1fr;
    }
    .incident-section,
    .pillars-section,
    .scenario-section {
      padding-block: var(--space-12);
    }
    .runtime-section {
      padding: var(--space-8) var(--space-6);
    }
    .pillars-section {
      margin-block-start: var(--space-12);
    }
    .hero-capture {
      padding: var(--space-3);
    }
  }
</style>
