---
import DesktopAppMock from "./mocks/DesktopAppMock.astro";
import ControlTowerMock from "./mocks/ControlTowerMock.astro";
import Button from "./Button.astro";
import { sections } from "../lib/content/product-mocks";
import { brandAssets } from "../lib/design-system";
import "../styles/product-mocks.css";
---

<div class="product-mocks" id="product" data-product-section>
  <section
    class="product-mock-section"
    id="desktop-app-mock"
    aria-labelledby="desktop-mock-heading"
  >
    <header class="product-mock-heading">
      <h2 id="desktop-mock-heading" class="named-section-title">
        <img
          src={brandAssets.mark.src}
          width={brandAssets.mark.width}
          height={brandAssets.mark.height}
          alt=""
        />
        {sections.desktop.label}
      </h2>
      <p class="named-section-subhead">{sections.desktop.heading}</p>
      <p>{sections.desktop.lede}</p>
    </header>
    <DesktopAppMock />
  </section>
  <section
    class="product-mock-section"
    id="control-tower-mock"
    aria-labelledby="admin-mock-heading"
  >
    <header class="product-mock-heading">
      <h2 id="admin-mock-heading" class="named-section-title">
        <img
          src={brandAssets.mark.src}
          width={brandAssets.mark.width}
          height={brandAssets.mark.height}
          alt=""
        />
        {sections.admin.label}
      </h2>
      <p class="named-section-subhead">{sections.admin.heading}</p>
      <p>{sections.admin.lede}</p>
    </header>
    <ControlTowerMock />
  </section>
  <div class="mock-demo-cta">
    <p>See how Glaux could work with your team.</p><Button
      href="https://www.glauxagent.com/contact/"
      variant="primary">Book a demo</Button
    >
  </div>
</div>
<script>
  import "./mocks/product-mocks";
</script>
