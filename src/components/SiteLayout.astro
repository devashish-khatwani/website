---
import "../styles/global.css";
import "../styles/marketing.css";
import BrandLogo from "./BrandLogo.astro";
import Button from "./Button.astro";
import ProductMenu from "./ProductMenu.astro";
import {
  buildAppLoginUrl,
  footerNavigation,
  primaryNavigation,
} from "../lib/site";

interface Props {
  title: string;
  description: string;
  canonicalUrl?: string;
  noindex?: boolean;
  referrerPolicy?: "no-referrer";
  og?: {
    title: string;
    description: string;
    url: string;
    type: string;
    image?: string;
    imageAlt?: string;
  };
}

const {
  title,
  description,
  canonicalUrl,
  noindex = false,
  referrerPolicy,
  og,
} = Astro.props;
const signInUrl = buildAppLoginUrl();
const currentPath = Astro.url.pathname;
const isProductSection = currentPath === "/product/";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {referrerPolicy && <meta name="referrer" content={referrerPolicy} />}
    <link rel="icon" type="image/svg+xml" href="/brand/glaux-mark.svg" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    {og && <meta property="og:type" content={og.type} />}
    {og && <meta property="og:title" content={og.title} />}
    {og && <meta property="og:description" content={og.description} />}
    {og && <meta property="og:url" content={og.url} />}
    {
      og?.image && (
        <>
          <meta property="og:image" content={og.image} />
          <meta property="og:image:alt" content={og.imageAlt} />
        </>
      )
    }
    <title>{title}</title>
  </head>
  <body>
    <div class="page-shell">
      <a class="skip-link" href="#main-content">Skip to main content</a>

      <header
        class:list={[
          "site-header",
          { "site-header--hero": currentPath === "/" },
        ]}
      >
        <a href="/" aria-label="Glaux home" class="brand-home">
          <BrandLogo priority alt="" />
        </a>

        <nav class="site-nav site-nav--desktop" aria-label="Primary">
          <div class="site-nav__pages">
            <details class="nav-dropdown" data-nav-dropdown>
              <summary
                class:list={[
                  "site-nav__link",
                  "nav-dropdown__trigger",
                  { "nav-dropdown__trigger--active": isProductSection },
                ]}
                aria-expanded="false"
                aria-controls="desktop-product-menu"
              >
                Product
                <svg
                  aria-hidden="true"
                  viewBox="0 0 12 8"
                  width="12"
                  height="8"
                >
                  <path d="M1 1.5 6 6.5l5-5"></path>
                </svg>
              </summary>
              <div class="nav-dropdown__panel" id="desktop-product-menu">
                <nav
                  class="nav-dropdown__content"
                  aria-label="Product sections"
                >
                  <ProductMenu />
                </nav>
              </div>
            </details>
            {
              primaryNavigation.map((item) => (
                <a
                  class="site-nav__link"
                  href={item.href}
                  aria-current={currentPath === item.href ? "page" : undefined}
                >
                  {item.label}
                </a>
              ))
            }
          </div>
          <div class="site-nav__actions">
            <a class="site-nav__link" href={signInUrl}> Sign in </a>
            <Button href="/contact/" variant="primary">Get a demo</Button>
          </div>
        </nav>

        <div class="site-header__mobile-demo">
          <Button href="/contact/" variant="primary">Get a demo</Button>
        </div>
        <details class="mobile-nav">
          <summary class="mobile-nav__summary" aria-label="Open navigation">
            <span>Menu</span>
            <svg
              aria-hidden="true"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"><path d="M3 6h18M3 12h18M3 18h18"></path></svg
            >
          </summary>
          <nav class="mobile-nav__panel" aria-label="Mobile primary">
            <details class="mobile-product">
              <summary
                class="site-nav__link"
                aria-expanded="false"
                aria-controls="mobile-product-menu">Product</summary
              >
              <div id="mobile-product-menu">
                <ProductMenu />
              </div>
            </details>
            {
              primaryNavigation.map((item) => (
                <a
                  class="site-nav__link"
                  href={item.href}
                  aria-current={currentPath === item.href ? "page" : undefined}
                >
                  {item.label}
                </a>
              ))
            }
            <a class="site-nav__link" href={signInUrl}>Sign in</a>
          </nav>
        </details>
      </header>

      <main id="main-content" tabindex="-1">
        <slot />
      </main>

      <footer class="site-footer">
        <div class="site-footer__inner">
          <div class="site-footer__brand">
            <BrandLogo alt="Glaux" />
            <p>Useful AI for work. Visible control for the organization.</p>
          </div>
          <nav class="site-footer__nav" aria-label="Footer">
            {
              footerNavigation.map((item) => (
                <a href={item.href}>{item.label}</a>
              ))
            }
            <a href={signInUrl}>Sign in</a>
            <Button href="/contact/" variant="primary">Get a demo</Button>
          </nav>
        </div>
      </footer>
    </div>

    <script>
      for (const dropdown of document.querySelectorAll<HTMLDetailsElement>(
        "[data-nav-dropdown]",
      )) {
        const trigger = dropdown.querySelector<HTMLElement>("summary");
        let hoverOpened = false;
        let pinned = false;
        let closeTimer: ReturnType<typeof setTimeout>;
        const setOpen = (open: boolean) => {
          clearTimeout(closeTimer);
          dropdown.open = open;
          trigger?.setAttribute("aria-expanded", String(open));
          if (!open) {
            pinned = false;
            hoverOpened = false;
          }
        };

        dropdown.addEventListener("pointerenter", () => {
          clearTimeout(closeTimer);
          if (
            window.matchMedia("(hover: hover) and (pointer: fine)").matches &&
            !dropdown.open
          ) {
            hoverOpened = true;
            setOpen(true);
          }
        });
        dropdown.addEventListener("pointerleave", () => {
          closeTimer = setTimeout(() => {
            if (!pinned && !dropdown.contains(document.activeElement))
              setOpen(false);
          }, 180);
        });
        trigger?.addEventListener("click", (event) => {
          event.preventDefault();
          if (hoverOpened && event.detail > 0) {
            hoverOpened = false;
            pinned = true;
          } else {
            setOpen(!dropdown.open);
            pinned = dropdown.open;
          }
        });
        dropdown.addEventListener("toggle", () => {
          trigger?.setAttribute("aria-expanded", String(dropdown.open));
        });
        dropdown.addEventListener("focusout", () => {
          requestAnimationFrame(() => {
            if (
              !dropdown.contains(document.activeElement) &&
              !dropdown.matches(":hover")
            )
              setOpen(false);
          });
        });
        document.addEventListener("click", (event) => {
          if (!dropdown.contains(event.target as Node)) setOpen(false);
        });
        document.addEventListener("keydown", (event) => {
          if (event.key === "Escape" && dropdown.open) {
            event.preventDefault();
            setOpen(false);
            trigger?.focus();
          }
        });
        dropdown.querySelectorAll("a").forEach((link) => {
          link.addEventListener("click", (event) => {
            if (
              !event.metaKey &&
              !event.ctrlKey &&
              !event.shiftKey &&
              !event.altKey
            )
              setOpen(false);
          });
        });
      }

      const mobileNavigation =
        document.querySelector<HTMLDetailsElement>(".mobile-nav");
      const mobileProduct =
        document.querySelector<HTMLDetailsElement>(".mobile-product");
      mobileProduct?.addEventListener("toggle", () => {
        mobileProduct
          .querySelector("summary")
          ?.setAttribute("aria-expanded", String(mobileProduct.open));
      });
      mobileNavigation?.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", (event) => {
          if (
            !event.metaKey &&
            !event.ctrlKey &&
            !event.shiftKey &&
            !event.altKey
          )
            mobileNavigation.open = false;
        });
      });
      mobileNavigation?.addEventListener("keydown", (event) => {
        if (event.key === "Escape") {
          const disclosure = mobileProduct?.open
            ? mobileProduct
            : mobileNavigation;
          disclosure.open = false;
          disclosure.querySelector<HTMLElement>("summary")?.focus();
        }
      });
    </script>
  </body>
</html>
