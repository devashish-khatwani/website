---
import DesktopAppMock from "./mocks/DesktopAppMock.astro";
import ControlTowerMock from "./mocks/ControlTowerMock.astro";
import { sections } from "../lib/content/product-mocks";
import "../styles/product-mocks.css";
---

<section
  class="product-mocks hero-showcase"
  aria-label="Glaux product previews"
>
  <div class="hero-product">
    <h2 class="plain-label">{sections.desktop.label}</h2><DesktopAppMock
      preview
    />
  </div>
  <div class="hero-product">
    <h2 class="plain-label">{sections.admin.label}</h2><ControlTowerMock
      preview
    />
  </div>
</section>
