---
import { models, people, groups } from "../../lib/content/product-mocks";
import {
  weekStart,
  weekEnd,
  type ExampleTrace,
} from "../../lib/content/product-mock-dataset";
import {
  money,
  statistics,
  series,
  displayTraceCosts,
} from "../../lib/content/product-mock-metrics";
import SessionsWorkbench from "./SessionsWorkbench.astro";
import DashboardChart from "./DashboardChart.astro";
import TraceDashboardDetail from "./TraceDashboardDetail.astro";
interface Props {
  id: string;
  traces: ExampleTrace[];
}
const { id, traces: rawTraces } = Astro.props;
const traces = displayTraceCosts(rawTraces);
const stats = statistics(traces);
const buckets = series(
  traces,
  Date.parse(`${weekStart}Z`),
  Date.parse(`${weekEnd}Z`),
);
const activity = buckets.map((b) => b.count);
const facts = rawTraces.map(
  ({
    id,
    sessionId,
    person,
    group,
    time,
    durationSeconds,
    costMillis,
    tokens,
    requests,
    model,
    blocked,
    error,
    search,
  }) => ({
    id,
    sessionId,
    person,
    group,
    time,
    durationSeconds,
    costMillis,
    tokens,
    requests,
    model,
    blocked,
    error,
    search,
  }),
);
---

<div
  class="mock-browser dash-observe-browser"
  data-browser
  data-observe-traces={JSON.stringify(facts)}
>
  <div data-detail-list>
    <section id={`observe-${id}-dashboard`} data-tab-panel="dashboard">
      <div class="dash-toolbar">
        <div>
          <h4>Overview</h4><p>
            Performance and usage across the selected traces.
          </p>
        </div><button type="button" class="dash-button" data-tab-go="deep-dive"
          >Open Deep Dive →</button
        >
      </div>
      <div class="dash-observe-grid">
        <section class="dash-card">
          <h5>Total traces</h5><div class="dash-observe-value">
            <strong data-observe-stat="count">{traces.length}</strong><span
              >Selected period</span
            >
          </div><DashboardChart
            values={activity}
            label="Trace activity"
            metric="count"
            compact
          />
        </section>
        <section class="dash-card">
          <h5>Sessions</h5><div class="dash-observe-value">
            <strong data-observe-stat="sessions">{stats.sessions}</strong><span
              >Selected period</span
            >
          </div><DashboardChart
            values={buckets.map((b) => b.sessions)}
            label="Session activity"
            metric="sessions"
            compact
          />
        </section>
        <section class="dash-card dash-assignment">
          <h5>Glaux users</h5><div class="dash-observe-value">
            <strong>{people.length}</strong><span>Assigned in Acme</span>
          </div><div class="dash-assignment-split">
            <span>People<strong>{people.length}</strong></span><span
              >Groups<strong>{groups.length}</strong></span
            >
          </div><p>
            Current workspace membership, independent of trace filters.
          </p>
        </section>
        <section class="dash-card">
          <h5>Latency (p95)</h5><div class="dash-observe-value">
            <strong data-observe-stat="latency">{stats.latency}s</strong><span
              >Selected period</span
            >
          </div><DashboardChart
            values={buckets.map((b) => b.latency)}
            label="Trace latency"
            metric="latency"
            compact
          />
        </section>
        <section class="dash-card">
          <h5>Total cost</h5><div class="dash-observe-value">
            <strong data-observe-stat="cost">{money(stats.cost)}</strong><span
              >Selected traces</span
            >
          </div><DashboardChart
            values={buckets.map((b) => b.cost / 1000)}
            label="Trace cost"
            metric="cost"
            compact
          />
        </section>
        <section class="dash-card">
          <h5>Cost by model</h5><div class="dash-observe-value">
            <strong data-observe-stat="cost">{money(stats.cost)}</strong><span
              data-observe-stat="models">{stats.models} models</span
            >
          </div><div class="dash-model-bars">
            {
              models.map((m) => {
                const cost = traces
                  .filter((t) => t.model === m.name)
                  .reduce((sum, t) => sum + t.costMillis, 0);
                return (
                  <div data-observe-model={m.name} hidden={!cost}>
                    <>
                      <span>
                        {m.name}
                        <strong data-model-cost>{money(cost)}</strong>
                      </span>
                      <div class="dash-bar">
                        <i
                          style={`width:${stats.cost ? (cost / stats.cost) * 100 : 0}%`}
                        />
                      </div>
                    </>
                  </div>
                );
              })
            }
          </div><p>Usage within the selected scope.</p>
        </section>
        <section class="dash-card dash-slowest">
          <h5>Slowest traces</h5><p>Open a trace to inspect its execution.</p>{
            [...traces]
              .sort((a, b) => b.durationSeconds - a.durationSeconds)
              .map((t, i) => (
                <button
                  type="button"
                  data-observe-record={t.id}
                  data-slowest
                  hidden={i >= 5}
                  data-open={`observe-${id}-${t.id}`}
                  aria-controls={`observe-${id}-${t.id}`}
                  aria-expanded="false"
                >
                  <>
                    <span>{t.task}</span>
                    <strong>{t.duration} ↗</strong>
                  </>
                </button>
              ))
          }
        </section>
        <section class="dash-card">
          <h5>Errors &amp; blocked steps</h5><div class="dash-observe-value">
            <strong data-observe-stat="issues"
              >{stats.errors + stats.blocked}</strong
            ><span data-observe-stat="issue-detail"
              >{stats.errors} errors · {stats.blocked} blocked</span
            >
          </div><DashboardChart
            values={buckets.map((b) => b.errors + b.blocked)}
            label="Errors and blocked step activity"
            metric="issues"
            compact
          />
        </section>
      </div>
      <p class="mock-note">
        {
          id === "own"
            ? "Showing your traces."
            : "Showing traces you have been granted access to."
        } Example data · November 19, 2026
      </p>
    </section>
    <section id={`observe-${id}-deep-dive`} data-tab-panel="deep-dive" hidden>
      <div class="dash-toolbar">
        <div>
          <h4>Deep Dive</h4><p>
            Follow a session or inspect an individual trace.
          </p>
        </div><span class="mock-pill" data-observe-stat="summary"
          >{stats.count} traces · {stats.sessions} sessions</span
        >
      </div>
      <div data-tabs={`records-${id}`}>
        <div class="mock-segments dash-record-tabs" aria-label="Record type">
          <button
            type="button"
            data-tab="sessions"
            aria-pressed="true"
            aria-controls={`observe-${id}-sessions`}>Sessions</button
          ><button
            type="button"
            data-tab="traces"
            aria-pressed="false"
            aria-controls={`observe-${id}-traces`}>Traces</button
          >
        </div>
        <div id={`observe-${id}-sessions`} data-tab-panel="sessions">
          <SessionsWorkbench id={id} traces={traces} />
        </div>
        <div
          id={`observe-${id}-traces`}
          data-tab-panel="traces"
          hidden
          data-traces-workbench
        >
          <div class="dash-traces-toolbar">
            <input
              type="search"
              aria-label="Search traces"
              placeholder="Search by trace name, ID, input or output…"
              data-observe-filter="query"
            /><select aria-label="Trace status" data-observe-filter="status"
              ><option value="">All statuses</option><option value="completed"
                >Completed</option
              ><option value="blocked">Blocked</option><option value="error"
                >Error</option
              ></select
            ><button
              type="button"
              class="dash-button"
              data-activity-toggle
              aria-pressed="true"
              aria-controls={`activity-${id}`}>Chart</button
            ><details class="dash-columns">
              <summary>Columns</summary><div>
                <strong>Visible columns</strong>{
                  [
                    "User",
                    "Group",
                    "Workspace",
                    "Duration",
                    "Tokens",
                    "Cost",
                    "Timestamp",
                  ].map((name) => (
                    <label>
                      <input
                        type="checkbox"
                        data-observe-column={name.toLowerCase()}
                        checked={name !== "Group" && name !== "Workspace"}
                      />
                      {name}
                    </label>
                  ))
                }
              </div>
            </details>
          </div>
          <section
            class="dash-card dash-trace-activity"
            id={`activity-${id}`}
            data-trace-activity
          >
            <div class="dash-card-heading">
              <h5>Trace activity</h5><span class="dash-activity-legend"
                >● Completed <span>● Errors / blocked</span></span
              >
            </div><DashboardChart
              values={activity}
              label="Trace activity"
              bars
              errors={buckets.map((b) => b.errors + b.blocked)}
              metric="activity"
            /><div class="dash-activity-stats">
              <span
                ><strong data-observe-stat="total">{traces.length}</strong> traces</span
              ><span
                ><strong data-observe-stat="latency">{stats.latency}s</strong> p95
                latency</span
              ><span
                ><strong data-observe-stat="tokens"
                  >{stats.tokens.toLocaleString()}</strong
                > tokens</span
              ><span
                ><strong data-observe-stat="cost">{money(stats.cost)}</strong> total
                cost</span
              >
            </div>
          </section>
          <div class="dash-table-wrap">
            <table
              class="dash-table dash-traces-table"
              aria-label="Traces, with example data"
            >
              <thead
                ><tr
                  ><th>Status</th><th>Trace</th><th data-column="user">User</th
                  ><th data-column="group" hidden>Group</th><th
                    data-column="workspace"
                    hidden>Workspace</th
                  ><th data-column="duration">Duration</th><th
                    data-column="tokens">Tokens</th
                  ><th data-column="cost">Cost</th><th data-column="timestamp"
                    >Timestamp</th
                  ></tr
                ></thead
              ><tbody
                >{
                  traces.map((t) => (
                    <tr data-observe-record={t.id}>
                      <>
                        <>
                          <td>
                            <span
                              class:list={[
                                "mock-pill",
                                t.blocked || t.error
                                  ? "mock-pill--red"
                                  : "mock-pill--green",
                              ]}
                            >
                              {t.error
                                ? "Error"
                                : t.blocked
                                  ? "1 blocked"
                                  : "Completed"}
                            </span>
                          </td>
                          <th scope="row">
                            <button
                              type="button"
                              class="dash-trace-name"
                              data-open={`observe-${id}-${t.id}`}
                              aria-controls={`observe-${id}-${t.id}`}
                              aria-expanded="false"
                              data-trace-id={t.id}
                              aria-label={`${t.person} ${t.task}, with example data`}
                            >
                              <>
                                <strong>{t.task}</strong>
                                <code>{t.id}</code>
                              </>
                            </button>
                          </th>
                          <td data-column="user">{t.person}</td>
                          <td data-column="group" hidden>
                            {people.find((p) => p.name === t.person)?.groups}
                          </td>
                          <td data-column="workspace" hidden>
                            Acme
                          </td>
                          <td data-column="duration">{t.duration}</td>
                          <td data-column="tokens">
                            {t.tokens.toLocaleString()}
                          </td>
                          <td data-column="cost">{money(t.costMillis)}</td>
                          <td data-column="timestamp">{t.when}</td>
                        </>
                      </>
                    </tr>
                  ))
                }</tbody
              >
            </table>
          </div>
          <p role="status" data-observe-empty hidden>
            No matching traces. Try a different filter or date range.
          </p><footer class="dash-table-footer">
            <span data-observe-stat="summary"
              >{stats.count} traces · {stats.sessions} sessions</span
            ><span>All times in PT · Example data</span>
          </footer>
        </div>
      </div><p class="mock-note">
        Acme · Example traces within your selected access scope.
      </p>
    </section>
  </div>
  {
    traces.map((t) => (
      <TraceDashboardDetail id={`observe-${id}-${t.id}`} trace={t} />
    ))
  }
</div>
