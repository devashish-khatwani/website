---
import {
  sessions,
  type ExampleTrace,
} from "../../lib/content/product-mock-dataset";
import { money } from "../../lib/content/product-mock-metrics";
interface Props {
  id: string;
  traces: ExampleTrace[];
}
const { id, traces } = Astro.props;
const conversations = sessions(traces);
---

<div class="dash-sessions-workbench" data-sessions>
  <section
    class="dash-conversations"
    role="region"
    aria-label="Conversations, with example data"
  >
    <header>
      <strong>Conversations</strong><span data-observe-stat="sessions"
        >{conversations.length}</span
      >
    </header>
    {
      conversations.map((session, i) => {
        const first = session.first;
        return (
          <button
            type="button"
            data-session-choice={session.id}
            aria-label={`${first.person} ${first.task}, with example data`}
            aria-pressed={i === 0 ? "true" : "false"}
            aria-controls={`session-${id}-${session.id}`}
          >
            <>
              <strong>{first.task}</strong>
              <span>{first.person} · Acme</span>
              <small>
                <span data-session-turns>{session.traces.length} turns</span> ·{" "}
                {session.latest.when}
              </small>
            </>
          </button>
        );
      })
    }
    <p data-conversations-empty hidden>No conversations match these filters.</p>
  </section>
  {
    conversations.map((session, i) => {
      const first = session.first;
      const duration = Math.max(
        ...session.traces.map((t) => t.durationSeconds),
      );
      return (
        <section
          id={`session-${id}-${session.id}`}
          class="dash-conversation-detail"
          data-session-panel={session.id}
          role="region"
          aria-label="Conversation detail, with example data"
          hidden={i !== 0}
        >
          <header class="dash-session-heading">
            <>
              <div>
                <>
                  <p class="mock-context">Conversation</p>
                  <h5>{first.task}</h5>
                  <p>
                    {first.person} · Acme · {session.id}
                  </p>
                </>
              </div>
              <button
                type="button"
                class="dash-button"
                data-waterfall-toggle
                aria-pressed="true"
                aria-controls={`waterfall-${id}-${session.id}`}
              >
                Waterfall
              </button>
            </>
          </header>
          <div class="dash-session-stats">
            <>
              <span data-session-turns>{session.stats.count} turns</span>
              <span>{first.when} · PT</span>
              <span data-session-tokens>
                {session.stats.tokens.toLocaleString()} tokens
              </span>
              <span data-session-cost>{money(session.stats.cost)}</span>
            </>
          </div>
          <section
            id={`waterfall-${id}-${session.id}`}
            class="dash-conversation-waterfall"
            data-conversation-waterfall
          >
            <>
              <h5>Conversation waterfall</h5>
              <p>Recorded steps · each turn starts at 0s</p>
            </>
            <div class="dash-turn-scale">
              <>
                <span>Turn / start time</span>
                <div>
                  <>
                    <span>0s</span>
                    <span>{Math.round(duration / 3)}s</span>
                    <span>{Math.round((duration * 2) / 3)}s</span>
                    <span>{duration}s</span>
                  </>
                </div>
              </>
            </div>
            {session.traces.map((t, turn) => {
              let elapsed = 0;
              return (
                <div class="dash-turn-row" data-observe-record={t.id}>
                  <div>
                    <strong>Turn {turn + 1}</strong>
                    <small>{t.time.slice(-5)} PT</small>
                    <small>{t.duration}</small>
                  </div>
                  <div class="dash-turn-bars">
                    <i
                      class="dash-turn-root"
                      style={`width:${(t.durationSeconds / duration) * 100}%`}
                    />
                    {t.timeline.map((step) => {
                      const offset = (elapsed / duration) * 100;
                      const width =
                        (parseFloat(step.duration) / duration) * 100;
                      elapsed += parseFloat(step.duration);
                      return (
                        <i
                          class:list={[
                            "dash-turn-step",
                            (step.blocked || t.error) && "is-blocked",
                          ]}
                          style={`margin-left:${offset}%;width:${Math.max(1, width)}%`}
                        />
                      );
                    })}
                  </div>
                </div>
              );
            })}
            <div class="dash-waterfall-legend">
              <>
                <span>● Run</span>
                <span>● Recorded step</span>
                <span>● Error / blocked step</span>
              </>
            </div>
          </section>
          <div class="dash-transcript-heading">
            <>
              <h5>Conversation</h5>
              <span>Inputs and outputs by turn</span>
            </>
          </div>
          {session.traces.map((t, turn) => (
            <article class="dash-turn-card" data-observe-record={t.id}>
              <header>
                <strong>Turn {turn + 1}</strong>
                <span>
                  {t.duration} · {t.when}
                </span>
                <button
                  type="button"
                  class="dash-text-button"
                  data-inspect={t.id}
                >
                  Inspect trace →
                </button>
              </header>
              <div class="dash-turn-message">
                <span>USER</span>
                <p>{t.input}</p>
              </div>
              <div class="dash-turn-message dash-turn-answer">
                <span>{t.error ? "ERROR" : "ASSISTANT"}</span>
                <p>{t.output}</p>
              </div>
            </article>
          ))}
        </section>
      );
    })
  }
  <div class="dash-no-conversation" data-no-conversation hidden>
    <h5>No conversations found</h5><p>
      Change your filters or date range to see conversations.
    </p>
  </div>
</div>
