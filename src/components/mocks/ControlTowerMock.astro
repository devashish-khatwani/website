---
import MockIcon from "./MockIcon.astro";
import MockFrame from "./MockFrame.astro";
import GatewayDashboard from "./GatewayDashboard.astro";
import ObservabilityDashboard from "./ObservabilityDashboard.astro";
import CloudAgents from "./CloudAgents.astro";
import ConnectionDetail from "./ConnectionDetail.astro";
import {
  adminViews,
  connections,
  people,
  groups,
  skills,
  auditEvents,
  workspace,
  accessExample,
} from "../../lib/content/product-mocks";
interface Props {
  preview?: boolean;
}
const { preview = false } = Astro.props;
const names = new Map(adminViews.map((view) => [view.id, view.name]));
---

{
  preview ? (
    <MockFrame
      kind="admin"
      views={adminViews}
      initial="connected-tools"
      preview
    >
      <article class="mock-preview-tools">
        <>
          <header class="mock-view-header">
            <div class="mock-heading-copy">
              <>
                <p class="mock-context">{workspace.organization} workspace</p>
                <h3>{names.get("connected-tools")}</h3>
                <p class="mock-description">
                  {
                    adminViews.find((view) => view.id === "connected-tools")
                      ?.description
                  }
                </p>
              </>
            </div>
          </header>
          <ConnectionDetail connection={connections[0]} preview />
        </>
      </article>
    </MockFrame>
  ) : (
    <MockFrame kind="admin" views={adminViews} initial="connected-tools">
      <article data-pane="people-access" id="mock-pane-people-access" hidden>
        <header class="mock-view-header">
          <>
            <div class="mock-heading-copy">
              <>
                <p class="mock-context">{workspace.organization} workspace</p>
                <h3>{names.get("people-access")}</h3>
                <p class="mock-description">
                  {
                    adminViews.find((view) => view.id === "people-access")
                      ?.description
                  }
                </p>
              </>
            </div>
            <span class="mock-pill">
              {workspace.organization} · {people.length} people
            </span>
          </>
        </header>
        <div class="mock-segments" aria-label="Directory view">
          <>
            <button
              type="button"
              data-directory="people"
              aria-pressed="true"
              aria-controls="mock-people"
            >
              People
            </button>
            <button
              type="button"
              data-directory="groups"
              aria-pressed="false"
              aria-controls="mock-groups"
            >
              Groups
            </button>
          </>
        </div>
        <div
          id="mock-people"
          data-directory-panel="people"
          class="mock-browser"
          data-browser
        >
          <div data-detail-list>
            <div class="mock-table-head mock-person-row" aria-hidden="true">
              <>
                <span>Name · Email</span>
                <span>Groups</span>
                <span>Role</span>
                <span class="mock-secondary">Last active</span>
              </>
            </div>
            {people.map((person, i) => (
              <button
                type="button"
                class="mock-row mock-person-row"
                data-open={`person-${i}`}
                aria-expanded="false"
                aria-controls={`person-${i}`}
              >
                <>
                  <span class="mock-identity">
                    <span class="mock-avatar" aria-hidden="true">
                      {person.name
                        .split(" ")
                        .map((part) => part[0])
                        .join("")}
                    </span>
                    <span>
                      <strong>{person.name}</strong>
                      <small>{person.email}</small>
                    </span>
                  </span>
                  <span>{person.groups}</span>
                  <span class="mock-pill">{person.role}</span>
                  <span class="mock-secondary mock-muted">{person.active}</span>
                </>
              </button>
            ))}
          </div>
          {people.map((person, i) => (
            <section
              id={`person-${i}`}
              class="mock-detail mock-person-detail"
              data-detail
              hidden
              tabindex="-1"
              aria-label={`${person.name} access`}
            >
              <>
                <button type="button" class="mock-back" data-close>
                  ← Back to people <span aria-hidden="true">×</span>
                </button>
                <span class="mock-avatar">
                  {person.name
                    .split(" ")
                    .map((part) => part[0])
                    .join("")}
                </span>
                <h4>{person.name}</h4>
                <p class="mock-muted">{person.email}</p>
                <dl>
                  <>
                    <dt>Groups</dt>
                    <dd>{person.groups}</dd>
                    <dt>Role</dt>
                    <dd>{person.role}</dd>
                    <dt>What they can use</dt>
                    <dd>{person.access}</dd>
                    <dt>Trace visibility</dt>
                    <dd>{person.visibility}</dd>
                  </>
                </dl>
              </>
            </section>
          ))}
        </div>
        <div id="mock-groups" data-directory-panel="groups" hidden>
          <table class="mock-table mock-groups-table">
            <>
              <thead>
                <tr>
                  <>
                    <th>Group</th>
                    <th>Members</th>
                    <th>Can use</th>
                  </>
                </tr>
              </thead>
              <tbody>
                {groups.map((group) => (
                  <tr>
                    <>
                      <th scope="row">{group.name}</th>
                      <td>
                        {group.members}{" "}
                        {group.members === 1 ? "member" : "members"}
                      </td>
                      <td>{group.access}</td>
                    </>
                  </tr>
                ))}
              </tbody>
            </>
          </table>
        </div>
      </article>
      <GatewayDashboard />
      <CloudAgents />
      <article data-pane="skills" id="mock-pane-skills" hidden>
        <header class="mock-view-header">
          <>
            <div class="mock-heading-copy">
              <>
                <p class="mock-context">{workspace.organization} workspace</p>
                <h3>{names.get("skills")}</h3>
                <p class="mock-description">
                  {adminViews.find((view) => view.id === "skills")?.description}
                </p>
              </>
            </div>
            <span class="mock-pill">{skills.length} skills</span>
          </>
        </header>
        <div class="mock-browser" data-browser>
          <div class="mock-card-grid mock-catalog" data-detail-list>
            {skills.map((skill, i) => (
              <button
                type="button"
                class="mock-card mock-skill"
                data-open={`skill-${i}`}
                aria-expanded="false"
                aria-controls={`skill-${i}`}
              >
                <>
                  <span class="mock-skill-top">
                    <>
                      <span class="mock-icon-tile">
                        <MockIcon name="skills" />
                      </span>
                      <span class="mock-pill">v{skill.version}</span>
                    </>
                  </span>
                  <strong>{skill.name}</strong>
                  <span>{skill.description}</span>
                  <small>
                    <span class="mock-catalog-status">Published</span> · @
                    {workspace.organization.toLowerCase()} · {skill.group}
                  </small>
                </>
              </button>
            ))}
          </div>
          {skills.map((skill, i) => (
            <section
              id={`skill-${i}`}
              class="mock-detail"
              data-detail
              hidden
              tabindex="-1"
              aria-label={`${skill.name} details`}
            >
              <>
                <button type="button" class="mock-back" data-close>
                  ← Back to skills
                </button>
                <h4>{skill.name}</h4>
                <p>{skill.description}</p>
                <dl>
                  <>
                    <dt>Live version</dt>
                    <dd>v{skill.version}</dd>
                    <dt>What's inside</dt>
                    <dd>
                      <ul class="mock-package">
                        {skill.files.map((file) => (
                          <li>
                            <code>{file}</code>
                          </li>
                        ))}
                      </ul>
                    </dd>
                    <dt>Version history</dt>
                    <dd>{skill.history}</dd>
                    <dt>Groups that can use it</dt>
                    <dd>{skill.group}</dd>
                  </>
                </dl>
              </>
            </section>
          ))}
        </div>
      </article>
      <article data-pane="connected-tools" id="mock-pane-connected-tools">
        <header class="mock-view-header">
          <>
            <div class="mock-heading-copy">
              <>
                <p class="mock-context">{workspace.organization} workspace</p>
                <h3>{names.get("connected-tools")}</h3>
                <p class="mock-description">
                  {
                    adminViews.find((view) => view.id === "connected-tools")
                      ?.description
                  }
                </p>
              </>
            </div>
            <span class="mock-pill">{connections.length} connections</span>
          </>
        </header>
        <div class="mock-tool-access-note">
          <>
            <MockIcon name="connected-tools" />
            <p>
              <>
                <strong>Tool access</strong>
                <span>{accessExample.note}</span>
              </>
            </p>
          </>
        </div>
        <div class="mock-toolbar">
          <>
            <span class="mock-pill mock-pill--green">
              {accessExample.revision}
            </span>
            <button
              type="button"
              class="mock-primary-button"
              data-open-access
              aria-expanded="false"
              aria-controls="mock-access-drawer"
            >
              Manage access
            </button>
          </>
        </div>
        <div
          class="mock-connections mock-browser has-detail"
          data-browser
          data-connections
        >
          <div class="mock-connection-list" data-detail-list>
            {connections.map((connection, i) => (
              <button
                type="button"
                class="mock-card"
                data-open={`connection-${i}`}
                aria-expanded={i === 0 ? "true" : "false"}
                aria-controls={`connection-${i}`}
              >
                <>
                  <span class="mock-connection-icon" aria-hidden="true">
                    <MockIcon name={i === 0 ? "database" : "connected-tools"} />
                  </span>
                  <strong>{connection.name}</strong>
                  <span>{connection.context}</span>
                  <small>{connection.group}</small>
                </>
              </button>
            ))}
          </div>
          {connections.map((connection, i) => (
            <section
              id={`connection-${i}`}
              class="mock-detail"
              data-detail
              hidden={i !== 0}
              tabindex="-1"
              aria-label={`${connection.name} access`}
            >
              <>
                <button type="button" class="mock-back" data-close>
                  ← All connections
                </button>
                <ConnectionDetail connection={connection} />
              </>
            </section>
          ))}
        </div>
        <section
          class="mock-access-drawer"
          id="mock-access-drawer"
          hidden
          tabindex="-1"
          aria-label="Engineering tool access"
        >
          <button type="button" class="mock-back" data-close-access>
            ← Back to connections <span aria-hidden="true">×</span>
          </button>
          <>
            <p class="mock-context">Connected Tools</p>
            <h4>{accessExample.title}</h4>
            <p class="mock-note">{accessExample.check}</p>
          </>
          <dl class="mock-meta-grid">
            <>
              <div>
                <>
                  <dt>User or group</dt>
                  <dd>{accessExample.subject}</dd>
                </>
              </div>
              <div>
                <>
                  <dt>Permission</dt>
                  <dd>{accessExample.permission}</dd>
                </>
              </div>
              <div>
                <>
                  <dt>Connection</dt>
                  <dd>{connections[0].name}</dd>
                </>
              </div>
              <div>
                <>
                  <dt>Granted by</dt>
                  <dd>
                    {people[0].name} · {accessExample.grantedOn}
                  </dd>
                </>
              </div>
            </>
          </dl>
          <p class="mock-context">Current grant</p>
          <ul class="mock-tool-list">
            {connections[0].tools.map((tool) => (
              <li>
                <code>{tool.name}</code>
                <span
                  class:list={["mock-pill", tool.allowed && "mock-pill--green"]}
                >
                  {tool.allowed ? "Allowed" : "Not granted"}
                </span>
              </li>
            ))}
          </ul>
          <div class="mock-access-reason">
            <>
              <strong>Reason</strong>
              <p>{accessExample.reason}</p>
            </>
          </div>
          <p class="mock-note">
            Example access record. No changes are published.
          </p>
        </section>
      </article>
      <ObservabilityDashboard />
      <article data-pane="audit" id="mock-pane-audit" hidden>
        <header class="mock-view-header">
          <>
            <div class="mock-heading-copy">
              <>
                <p class="mock-context">{workspace.organization} workspace</p>
                <h3>{names.get("audit")}</h3>
                <p class="mock-description">
                  {adminViews.find((view) => view.id === "audit")?.description}
                </p>
              </>
            </div>
            <span class="mock-pill">Last 7 days</span>
          </>
        </header>
        <div class="mock-audit-filters">
          <>
            <div>
              <>
                <span>Time range</span>
                <strong>{workspace.auditRange}</strong>
              </>
            </div>
            <div>
              <>
                <span>Area</span>
                <strong>All areas</strong>
              </>
            </div>
            <div>
              <>
                <span>Outcome</span>
                <strong>All outcomes</strong>
              </>
            </div>
          </>
        </div>
        <p class="mock-list-label">
          Activity <span>{auditEvents.length} events · Newest first</span>
        </p>
        <div class="mock-audit-list">
          {auditEvents.map((event) => (
            <details
              name="mock-audit-events"
              class="mock-audit-event"
              open={event.id === "evt_31d9a07c"}
            >
              <>
                <summary>
                  <>
                    <time>{event.when}</time>
                    <span>{people[0].name}</span>
                    <strong>{event.what}</strong>
                    <span aria-hidden="true">⌄</span>
                  </>
                </summary>
                <div>
                  <p>
                    <strong>Who:</strong> {people[0].name} (Admin)
                  </p>
                  <p>
                    <strong>Change:</strong> {event.before} → {event.after}
                  </p>
                  {"note" in event && <p>{event.note}</p>}
                  <p>
                    <strong>When:</strong> {event.timestamp}
                  </p>
                  <p class="mock-mono">{event.id}</p>
                </div>
              </>
            </details>
          ))}
        </div>
      </article>
    </MockFrame>
  )
}
