---
import { productSection } from "../../lib/content/product-section";
import {
  people,
  traces,
  workspace,
  type MockView,
} from "../../lib/content/product-mocks";
import MockIcon from "./MockIcon.astro";
interface Props {
  kind: "desktop" | "admin";
  views: MockView[];
  initial: string;
  preview?: boolean;
}
const { kind, views, initial, preview = false } = Astro.props;
const desktop = kind === "desktop";
const product = desktop ? "Glaux desktop app" : "Glaux Control Tower";
const name = `${product} ${desktop ? "views" : "panes"}${preview ? " preview" : ""}`;
const Item = preview ? "span" : "button";
---

<div
  class:list={["mock-frame", `mock-frame--${kind}`, preview && "mock-preview"]}
  data-mock={preview ? undefined : kind}
  data-mock-preview={preview ? kind : undefined}
>
  {
    desktop && (
      <div class="mock-titlebar">
        <>
          <span class="mock-dots" aria-hidden="true">
            <>
              <i />
              <i />
              <i />
            </>
          </span>
          <span class="mock-session-tab">
            Glaux <span aria-hidden="true">/</span> {workspace.organization}
          </span>
          <span class="mock-example">Example data</span>
        </>
      </div>
    )
  }
  <div class="mock-window">
    <nav class="mock-sidebar" aria-label={name}>
      {
        !desktop && (
          <div class="mock-brand">
            <>
              <img src="/brand/glaux-mark.svg" width="24" height="30" alt="" />
              <div>
                <>
                  <strong>Glaux</strong>
                  <small>Control Tower</small>
                </>
              </div>
            </>
          </div>
        )
      }
      {
        views.map((view, i) => (
          <Item
            class="mock-nav-item"
            type={preview ? undefined : "button"}
            data-view={preview ? undefined : view.id}
            aria-pressed={preview ? undefined : view.id === initial}
            aria-current={preview && view.id === initial ? "page" : undefined}
            aria-disabled={preview ? "true" : undefined}
            aria-controls={preview ? undefined : `${kind}-view`}
            title={
              productSection.panes.find((pane) => pane.id === view.id)?.summary
            }
          >
            <>
              <MockIcon name={view.id} />
              <span>{view.name}</span>
              {desktop && i === 0 && !preview && <kbd>⌘N</kbd>}
            </>
          </Item>
        ))
      }
      {
        !preview &&
          (desktop ? (
            <>
              <>
                <div class="mock-recents">
                  <p>Sessions</p>
                  {traces.slice(0, 3).map((trace) => (
                    <span>{trace.task}</span>
                  ))}
                </div>
                <div class="mock-user">
                  <>
                    <span class="mock-avatar">SL</span>
                    <span>
                      {people[1].name}
                      <small>
                        {workspace.organization} · {people[1].groups}
                      </small>
                    </span>
                  </>
                </div>
              </>
            </>
          ) : (
            <>
              <>
                <div class="mock-soon" data-coming-soon>
                  <p id="product-soon-heading">Coming soon</p>
                  {productSection.comingSoon.items.map((item) => (
                    <span aria-disabled="true" title={item.teaser}>
                      {item.name}
                      <small>Soon</small>
                    </span>
                  ))}
                </div>
                <div class="mock-user">
                  <>
                    <span class="mock-avatar">MO</span>
                    <span>
                      {people[0].name}
                      <small>Workspace admin</small>
                    </span>
                  </>
                </div>
              </>
            </>
          ))
      }
    </nav>
    <div class="mock-workspace">
      {
        !desktop && (
          <div class="mock-topbar">
            <>
              <span class="mock-workspace-picker">
                <>
                  <MockIcon name="panel" />
                  <span class="mock-muted">Workspace</span>
                  <strong>
                    {workspace.organization} production{" "}
                    <span aria-hidden="true">⌄</span>
                  </strong>
                </>
              </span>
              <span class="mock-example">Example data</span>
              <span class="mock-signed-in">{people[0].name}</span>
              <span class="mock-avatar" aria-label={people[0].name}>
                MO
              </span>
            </>
          </div>
        )
      }
      <div
        class="mock-main"
        id={`${preview ? "hero-" : ""}${kind}-view`}
        role="region"
        aria-label={`${preview ? `${product}: ` : ""}${views.find((view) => view.id === initial)?.name}, with example data`}
        tabindex={preview ? undefined : "-1"}
      >
        <slot />
      </div>
    </div>
  </div>
  {
    !preview && (
      <p class="mock-toast" role="status" hidden>
        Example only: nothing changes.
      </p>
    )
  }
</div>
{
  !preview && (
    <>
      <div class="mock-caption" aria-live="polite" aria-atomic="true">
        {views.map((view) => (
          <div data-caption={view.id} hidden={view.id !== initial}>
            <div>
              <h3>{view.caption}</h3>
              <p>{view.takeaway}</p>
            </div>
            <ul aria-label="Highlights">
              {view.chips.map((chip) => (
                <li>
                  <span aria-hidden="true">✓</span> {chip}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
      {!desktop && (
        <p class="mock-mobile-soon">
          Coming soon:{" "}
          {productSection.comingSoon.items.map((item) => item.name).join(", ")}
        </p>
      )}
    </>
  )
}
