---
import MockFrame from "./MockFrame.astro";
import SessionView from "./SessionView.astro";
import TraceExplorer from "./TraceExplorer.astro";
import {
  desktopViews,
  run,
  traces,
  connections,
  skills,
  artifacts,
  automation,
} from "../../lib/content/product-mocks";
interface Props {
  preview?: boolean;
}
const { preview = false } = Astro.props;
---

{
  preview ? (
    <MockFrame
      kind="desktop"
      views={desktopViews}
      initial="desktop-app"
      preview
    >
      <SessionView preview />
    </MockFrame>
  ) : (
    <MockFrame kind="desktop" views={desktopViews} initial="desktop-app">
      <SessionView />
      <article
        data-pane="desktop-app-capabilities"
        id="mock-pane-desktop-app-capabilities"
        hidden
      >
        <header class="mock-view-header">
          <>
            <h3>What your coworker can use</h3>
            <span class="mock-pill">Set by your admin</span>
          </>
        </header>
        <div class="mock-capabilities">
          <section class="mock-card">
            <h4>Skills</h4>
            {skills.slice(0, 3).map((skill) => (
              <div class="mock-item">
                <>
                  <strong>{skill.name}</strong>
                  <span class="mock-muted">v{skill.version}</span>
                </>
              </div>
            ))}
          </section>
          <section class="mock-card">
            <h4>Connected Tools</h4>
            <details class="mock-disclosure">
              <>
                <summary>
                  {run.database}
                  <small>
                    Read ✓ · Write ✓ · Drop: Not granted · Alter: Not granted
                  </small>
                </summary>
                <ul class="mock-tool-list">
                  {connections[0].tools.map((tool) => (
                    <li>
                      <>
                        <code>{tool.name}</code>
                        <span
                          class:list={[
                            "mock-pill",
                            tool.allowed && "mock-pill--green",
                          ]}
                        >
                          {tool.access}
                        </span>
                      </>
                    </li>
                  ))}
                </ul>
              </>
            </details>
            {connections.slice(1, 3).map((connection) => (
              <div class="mock-item">
                <>
                  <strong>
                    {connection.name} ({connection.context})
                  </strong>
                  <span class="mock-pill mock-pill--green">
                    {connection.name === "GitHub" ? "Read" : "Post"}
                  </span>
                </>
              </div>
            ))}
          </section>
        </div>
        <p class="mock-note">
          Your admin manages this list in the Glaux Control Tower. Choose a
          model in your session's model menu.
        </p>
      </article>
      <article
        data-pane="desktop-app-traces"
        id="mock-pane-desktop-app-traces"
        hidden
      >
        <header class="mock-view-header">
          <>
            <h3>My traces</h3>
            <span class="mock-pill">Visible to you</span>
          </>
        </header>
        <p class="mock-note">
          Admins can see your traces only if they've been given access.
        </p>
        <TraceExplorer
          id="desktop-trace"
          traces={[...traces, automation.trace]}
        />
      </article>
      <article
        data-pane="desktop-app-artifacts"
        id="mock-pane-desktop-app-artifacts"
        hidden
      >
        <header class="mock-view-header">
          <>
            <h3>Artifacts</h3>
            <span class="mock-pill">{artifacts.length} files</span>
          </>
        </header>
        <div class="mock-browser" data-browser>
          <div class="mock-card-grid" data-detail-list>
            {artifacts.map((artifact, i) => (
              <button
                type="button"
                class="mock-card mock-file"
                data-open={`artifact-${i}`}
                aria-expanded="false"
                aria-controls={`artifact-${i}`}
              >
                <>
                  <span class="mock-file-icon" aria-hidden="true">
                    ▤
                  </span>
                  <strong>{artifact.name}</strong>
                  <span>{artifact.task}</span>
                  <small>{artifact.when}</small>
                </>
              </button>
            ))}
          </div>
          {artifacts.map((artifact, i) => (
            <section
              class="mock-detail"
              id={`artifact-${i}`}
              data-detail
              hidden
              tabindex="-1"
              aria-label={artifact.name}
            >
              <>
                <button type="button" class="mock-back" data-close>
                  ← Back to artifacts
                </button>
                <h4>{artifact.name}</h4>
                <pre>{artifact.content}</pre>
              </>
            </section>
          ))}
        </div>
      </article>
      <article
        data-pane="desktop-app-automations"
        id="mock-pane-desktop-app-automations"
        hidden
      >
        <header class="mock-view-header">
          <>
            <h3>Automations</h3>
            <span class="mock-pill">1 scheduled task</span>
          </>
        </header>
        <section class="mock-card mock-automation">
          <>
            <div class="mock-view-header">
              <>
                <h4>{automation.name}</h4>
                <span class="mock-pill mock-pill--green" data-automation-status>
                  Active
                </span>
              </>
            </div>
            <p>{run.database}</p>
            <dl class="mock-meta-grid">
              <>
                <div>
                  <>
                    <dt>Schedule</dt>
                    <dd>{automation.schedule}</dd>
                  </>
                </div>
                <div>
                  <>
                    <dt>Owner</dt>
                    <dd>{automation.owner}</dd>
                  </>
                </div>
                <div>
                  <>
                    <dt>Location</dt>
                    <dd>{automation.location}</dd>
                  </>
                </div>
                <div>
                  <>
                    <dt>Next run</dt>
                    <dd data-next-run data-scheduled={automation.next}>
                      {automation.next}
                    </dd>
                  </>
                </div>
              </>
            </dl>
            <p class="mock-note">
              Scheduled work on this device runs while the app is available.
            </p>
            <button
              type="button"
              class="mock-switch"
              role="switch"
              aria-checked="true"
              aria-label="Scheduled task active"
              data-automation-toggle
            >
              <>
                <span class="mock-switch-track" aria-hidden="true" />
                <span data-switch-text>Active</span>
              </>
            </button>
          </>
        </section>
        <section class="mock-card mock-run-history">
          <>
            <h4>Last run</h4>
            <p class="mock-muted">{automation.last}</p>
            <p>{automation.result}</p>
            <button
              type="button"
              class="mock-text-button"
              data-jump="desktop-app-traces"
              data-trace={automation.trace.id}
            >
              Find this run in My traces →
            </button>
          </>
        </section>
      </article>
    </MockFrame>
  )
}
