---
import {
  connections,
  people,
  accessExample,
} from "../../lib/content/product-mocks";
interface Props {
  connection: (typeof connections)[number];
  preview?: boolean;
}
const { connection, preview = false } = Astro.props;
const tools = preview
  ? connection.tools.filter((_, index) => index === 0 || index >= 4)
  : connection.tools;
---

<div class="mock-connection-heading">
  <h4>{connection.name}</h4><span class="mock-pill mock-pill--green"
    >Connected</span
  >
</div>
<p class="mock-note">
  Granted to {connection.group} · by {people[0].name} · {
    accessExample.grantedOn
  }
</p>
<table class="mock-table mock-tool-table">
  <thead
    ><tr><th>Tool</th>{!preview && <th>What it does</th>}<th>Access</th></tr
    ></thead
  >
  <tbody
    >{
      tools.map((tool) => (
        <tr>
          <th scope="row">
            <code>{tool.name}</code>
          </th>
          {!preview && <td>{tool.description}</td>}
          <td>
            <span
              class:list={["mock-pill", tool.allowed && "mock-pill--green"]}
            >
              {tool.allowed ? "Allowed" : "Not granted"}
            </span>
          </td>
        </tr>
      ))
    }</tbody
  >
</table>
{
  !preview && (
    <p class="mock-note">
      Only explicitly granted tools are available through this connection.
    </p>
  )
}
