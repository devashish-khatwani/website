};
if (name !== "desktop" && !icons[name])
  throw new Error(`Unknown product icon: ${name}`);
---

{
  name === "desktop" ? (
    <img src="/brand/glaux-mark.svg" width="20" height="32" alt="" />
  ) : (
    <svg
      viewBox={
        name === "ai"
          ? "0 0 27 27"
          : name === "chevron"
            ? "0 0 16 16"
            : "0 0 24 24"
      }
      width="24"
      height="24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      set:html={icons[name]}
    />
  )
}
